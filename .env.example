DATABASE_URL="postgresql://user:password@127.0.0.1:5432/sqa"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Created automatically when a Vercel Blob store is connected to the project.
# Never commit the real value.
BLOB_READ_WRITE_TOKEN=""
# Mail.ru website notifications. Create an app password with sending-only access;
# the regular mailbox password does not work for SMTP. Keep the app password in
# a production Secret on Vercel, never in the repository.
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_USER="info@sqa.uz"
SMTP_PASSWORD=""
SMTP_FROM="SQA Group <info@sqa.uz>"
COMPANY_RECEIVER_EMAIL="info@sqa.uz"
# Set only for local browser tests that deliberately exercise the local adapter.
# MEDIA_STORAGE="local"
